{
  "name": "footprint-research-local",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-22",
  "d1_databases": [{"binding":"DB","database_name":"footprint-research-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000",
    "TEAM_DOMAIN": "https://REPLACE.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAILS_COMMA_SEPARATED",
    "RETENTION_DAYS": "90"
  },
  "triggers": {"crons":["0 3 * * *"]},
  "observability": {"enabled": false}
}
