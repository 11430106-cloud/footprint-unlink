{
  "name": "footprint-research",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-22",
  "d1_databases": [{"binding":"DB","database_name":"footprint-research","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "vars": {
    "ALLOWED_ORIGIN": "https://11430106-cloud.github.io",
    "TEAM_DOMAIN": "https://REPLACE.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAILS_COMMA_SEPARATED",
    "RETENTION_DAYS": "90"
  },
  "triggers": {"crons":["0 3 * * *"]},
  "observability": {"enabled": false}
}
